# Python environments
envs/.venv-old/
envs/.venv-new/
.venv/
__pycache__/
*.pyc

# Node
harness/node_modules/
node_modules/
tests/node_modules/

# Render artifacts. goldens/ holds screenshots of the user's proprietary course
# slides, so it is NOT published — kept local, regenerable via scripts/render-old.ps1.
goldens/
shots/
reports/
test-results/
playwright-report/
harness/.cache/

# Scratch / diagnostic screenshots (probe-layout*, probe-greybar output)
scratch-layout/

# Jupyter runtime-generated state (not the tracked base config)
envs/*/jupyter-config/lab/
envs/*/jupyter-config/serverconfig/

# Misc
*.log
.DS_Store
Thumbs.db
